# Copy to .env for local use. Never commit real secrets.
APP_ENV=development
API_ADDR=:8080
GATEWAY_ADDR=:8081
DATABASE_URL=postgres://slogan:slogan@127.0.0.1:5432/slogan?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
# 32 random bytes encoded as 64 hex chars; use a secret manager in production.
PROVIDER_SECRET_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
SESSION_TTL=24h
REQUEST_MAX_OUTPUT_TOKENS=8192
MAX_RESERVATION_MICRO=0
RATE_LIMIT_GLOBAL_PER_MIN=0
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_KEY_PER_MIN=600
RATE_LIMIT_MODEL_PER_MIN=0
RATE_LIMIT_PROVIDER_PER_MIN=0
LAYA_ENABLED=false
LAYA_BASE_URL=http://127.0.0.1:8000
LAYA_API_KEY_FILE=deploy/secrets/laya_api_key.txt
LAYA_TIMEOUT=500ms
LAYA_MIN_CONFIDENCE=0.60
LAYA_MAX_INPUT_RUNES=4000
EVAL_MAX_TOKENS=2000
EVAL_CONCURRENCY=5
EVAL_TIMEOUT=60s
EVAL_MIN_PUBLISH_RATIO=0.80
EVAL_MAX_REFRESHES_PER_DAY=1
SCORE_ACK_TIMEOUT=15s
# Optional load-balancer control plane. Unconfigured nodes are never excluded from ACK.
LB_MEMBERSHIP_URL=
LB_MEMBERSHIP_TOKEN_FILE=deploy/secrets/lb_membership_token.txt
# Internal scrape listener (empty disables it). The token is required before any
# scrape is served, so a misconfigured deployment fails closed.
METRICS_ADDR=
METRICS_TOKEN_FILE=deploy/secrets/metrics_token.txt
CONTENT_LOG_ENABLED=false
CONTENT_LOG_RETENTION_DAYS=7
